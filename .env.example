# DeepSeek API Key（必填，注册 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek Base URL（可选，默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek 模型名（可选，默认 deepseek-v4-flash）
# DEEPSEEK_MODEL=deepseek-v4-flash

# 是否流式输出 LLM 响应（可选，默认 false）
# 启用后 chatCompletion 会实时把 delta 打印到 stdout，提升交互体验
# 调用方仍可通过 options.stream=true/false 在单次调用上覆盖此全局配置
# ENABLE_STREAM=false

# 是否启用 Function Calling 工具调用模式（可选，默认 false）
# false：ReAct 文本模式（LLM 输出 Thought/Action 文本，代码解析 toolName[toolInput] 调工具）
# true ：原生 Function Calling（tools schema 传给 API，LLM 返回 tool_calls，基类 _handleToolCalls 执行）
# 也可在构造 Agent 时传 useFunctionCalling 选项覆盖此全局配置
# ENABLE_FUNCTION_CALLING=false
